# Public application endpoints. Replace the storage origins with a comma-separated
# allowlist of the exact S3/R2 browser upload origins used in each environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_STORAGE_ORIGINS=
# Required in production because the public CTA must never be a dead control.
# Use a company-owned Calendly event URL.
NEXT_PUBLIC_CALENDLY_URL=

# Analytics remains disabled while the measurement ID is blank.
NEXT_PUBLIC_GA_ID=

# These must stay blank until the matching published legal documents are approved.
NEXT_PUBLIC_LEGAL_TERMS_VERSION=
NEXT_PUBLIC_LEGAL_PRIVACY_VERSION=
NEXT_PUBLIC_LEGAL_AGE14_VERSION=
NEXT_PUBLIC_LEGAL_CREATOR_THIRD_PARTY_VERSION=
NEXT_PUBLIC_LEGAL_MARKETING_VERSION=
NEXT_PUBLIC_PRIVACY_OFFICER_NAME=
NEXT_PUBLIC_PRIVACY_OFFICER_CONTACT=

# Sentry is fully disabled when both DSN values are blank.
# NEXT_PUBLIC_* values are embedded into the browser bundle at build time.
NEXT_PUBLIC_SENTRY_DSN=
# Optional server/edge override. Falls back to NEXT_PUBLIC_SENTRY_DSN when blank.
SENTRY_DSN=

# Decimal from 0 to 1. Invalid/out-of-range values fail closed to 0.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_TRACES_SAMPLE_RATE=0.05

# Use stable environment and release names to group production events.
NEXT_PUBLIC_SENTRY_ENV=development
SENTRY_ENV=development
NEXT_PUBLIC_SENTRY_RELEASE=
SENTRY_RELEASE=
