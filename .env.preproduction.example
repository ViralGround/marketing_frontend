# Canonical sanitized-staging build contract. Copy these names into the
# isolated Vercel staging project's production deployment (`VERCEL_ENV` must be
# exactly `production`); never attach this template to Preview or the currently
# running production project. Blank values are intentional gates.
NEXT_PUBLIC_SITE_URL=https://staging.viralground.kr
NEXT_PUBLIC_API_URL=https://api.staging.viralground.kr
NEXT_PUBLIC_STORAGE_ORIGINS=
APP_ENV=preproduction
NEW_PRODUCTION_DEPLOY_CONFIRMATION=
APPROVED_NEW_PRODUCTION_SITE_ORIGIN=
APPROVED_NEW_PRODUCTION_API_ORIGIN=
APPROVED_NEW_PRODUCTION_STORAGE_ORIGINS=

# Staging stays noindex and analytics-free. Every unreleased feature is off.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_FEATURE_PAYMENTS=false
NEXT_PUBLIC_FEATURE_INSTAGRAM=false
NEXT_PUBLIC_FEATURE_UPLOADS=false

# Non-secret immutable release identity. Vercel supplies
# VERCEL_GIT_COMMIT_SHA; do not override it with a different commit.
NEXT_PUBLIC_RELEASE_ID=
RELEASE_ID=

# Public company disclosure. Fill only with the approved staging display set.
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_BUSINESS_CEO=
NEXT_PUBLIC_BUSINESS_REG_NO=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_CONTACT=
NEXT_PUBLIC_BUSINESS_MAIL_ORDER_NO=

# One approval record must supply this exact five-value set to both the
# frontend and backend templates. Never advance only one deployment.
NEXT_PUBLIC_LEGAL_TERMS_VERSION=
NEXT_PUBLIC_LEGAL_PRIVACY_VERSION=
NEXT_PUBLIC_LEGAL_AGE14_VERSION=
NEXT_PUBLIC_LEGAL_CREATOR_THIRD_PARTY_VERSION=
NEXT_PUBLIC_LEGAL_MARKETING_VERSION=
NEXT_PUBLIC_PRIVACY_OFFICER_NAME=
NEXT_PUBLIC_PRIVACY_OFFICER_CONTACT=

# Keep staging in its own Sentry project/environment and bind both browser and
# server events to the approved frontend commit. Each exact identity is the
# role-specific `host/projectId` (never a DSN/public key), and the two identities
# must be distinct. DSNs contain no auth secret, but are blank here to prevent
# accidental project reuse.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
APPROVED_STAGING_FRONTEND_SENTRY_DSN_IDENTITY=
APPROVED_STAGING_BACKEND_SENTRY_DSN_IDENTITY=
NEXT_PUBLIC_SENTRY_ENV=preproduction
SENTRY_ENV=preproduction
NEXT_PUBLIC_SENTRY_RELEASE=
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_TRACES_SAMPLE_RATE=0.05
