generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CREATOR
  COMPANY
  ADMIN
}

enum MemberStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EditingTool {
  CAPCUT
  PREMIERE
  FINAL_CUT
  VN
  OTHER
  NONE
}

enum EditingSkill {
  HIGH
  MEDIUM
  LOW
}

enum CampaignStatus {
  DRAFT
  OPEN
  CLOSED
}

enum EscrowStatus {
  NONE
  PENDING_DEPOSIT
  DEPOSIT_CONFIRMING
  FUNDED
  PARTIALLY_RELEASED
  REFUNDED
}

enum EscrowTxType {
  DEPOSIT
  RELEASE
  REFUND
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  SUBMITTED
  SETTLED
}

model Member {
  id                   Int                   @id @default(autoincrement())
  email                String                @unique
  password             String
  name                 String
  role                 Role
  status               MemberStatus          @default(APPROVED)
  emailVerified        Boolean               @default(false) @map("email_verified")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  creatorProfile       CreatorProfile?
  companyProfile       CompanyProfile?
  campaignsCreated     Campaign[]            @relation("CampaignAuthor")
  applications         CampaignApplication[] @relation("CreatorApplications")
  emailVerification    EmailVerification?

  @@map("members")
}

model EmailVerification {
  id        Int      @id @default(autoincrement())
  memberId  Int      @unique @map("member_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("email_verifications")
}

model CreatorProfile {
  id            Int          @id @default(autoincrement())
  memberId      Int          @unique @map("member_id")
  member        Member       @relation(fields: [memberId], references: [id])
  canEdit       Boolean      @default(false) @map("can_edit")
  editingSkill  EditingSkill @default(LOW) @map("editing_skill")
  editingTool   EditingTool? @map("editing_tool")
  gender        Gender?
  age           Int?
  faceExposure  Boolean      @default(false) @map("face_exposure")
  profileImage  String?      @map("profile_image")
  instagramId   String?      @map("instagram_id")
  tiktokId      String?      @map("tiktok_id")
  youtubeId     String?      @map("youtube_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("creator_profiles")
}

model CompanyProfile {
  id                 Int      @id @default(autoincrement())
  memberId           Int      @unique @map("member_id")
  member             Member   @relation(fields: [memberId], references: [id])
  companyName        String   @map("company_name")
  businessNumber     String   @map("business_number")
  representativeName String   @map("representative_name")
  contactName        String   @map("contact_name")
  contactPhone       String   @map("contact_phone")
  address            String?
  homepage           String?
  industry           String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("company_profiles")
}

model Campaign {
  id                  Int                    @id @default(autoincrement())
  title               String
  description         String
  brandName           String                 @map("brand_name")
  rewardAmount        Int                    @map("reward_amount")
  totalBudget         Int                    @default(0) @map("total_budget")
  escrowStatus        EscrowStatus           @default(NONE) @map("escrow_status")
  depositRequestedAt  DateTime?              @map("deposit_requested_at")
  fundedAt            DateTime?              @map("funded_at")
  refundedAt          DateTime?              @map("refunded_at")
  thumbnailUrl        String?                @map("thumbnail_url")
  requirements        String?
  deadline            DateTime?
  maxParticipants     Int                    @map("max_participants")
  status              CampaignStatus         @default(DRAFT)
  createdById         Int                    @map("created_by_id")
  createdBy           Member                 @relation("CampaignAuthor", fields: [createdById], references: [id])
  applications        CampaignApplication[]
  escrowTransactions  EscrowTransaction[]
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  @@map("campaigns")
}

model EscrowTransaction {
  id                Int          @id @default(autoincrement())
  campaignId        Int          @map("campaign_id")
  campaign          Campaign     @relation(fields: [campaignId], references: [id])
  applicationId     Int?         @map("application_id")
  type              EscrowTxType
  amount            Int
  memo              String?
  createdAt         DateTime     @default(now()) @map("created_at")

  @@index([campaignId])
  @@map("escrow_transactions")
}

model CampaignApplication {
  id               Int               @id @default(autoincrement())
  campaignId       Int               @map("campaign_id")
  campaign         Campaign          @relation(fields: [campaignId], references: [id])
  creatorId        Int               @map("creator_id")
  creator          Member            @relation("CreatorApplications", fields: [creatorId], references: [id])
  status           ApplicationStatus @default(PENDING)
  message          String?
  submissionUrl    String?           @map("submission_url")
  rewardPaidAmount Int?              @map("reward_paid_amount")
  appliedAt        DateTime          @default(now()) @map("applied_at")
  reviewedAt       DateTime?         @map("reviewed_at")
  submittedAt      DateTime?         @map("submitted_at")
  settledAt        DateTime?         @map("settled_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@unique([campaignId, creatorId])
  @@map("campaign_applications")
}
