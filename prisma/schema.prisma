generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  COMPANY
  CREATOR
  ADMIN
}

enum MemberStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EditingTool {
  CAPCUT
  PREMIERE
  FINAL_CUT
  VN
  OTHER
  NONE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum EditingSkill {
  HIGH
  MEDIUM
  LOW
}

model Member {
  id             Int              @id @default(autoincrement())
  email          String           @unique
  password       String
  name           String
  role           Role
  status         MemberStatus     @default(APPROVED)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  contents       Content[]
  creatorProfile CreatorProfile?

  @@map("members")
}

model CreatorProfile {
  id            Int          @id @default(autoincrement())
  memberId      Int          @unique @map("member_id")
  member        Member       @relation(fields: [memberId], references: [id])
  canEdit       Boolean      @default(false) @map("can_edit")
  editingSkill  EditingSkill @default(LOW) @map("editing_skill")
  editingTool   EditingTool? @map("editing_tool")
  gender        Gender?
  age           Int?
  faceExposure  Boolean      @default(false) @map("face_exposure")
  profileImage  String?      @map("profile_image")
  instagramId   String?      @map("instagram_id")
  tiktokId      String?      @map("tiktok_id")
  youtubeId     String?      @map("youtube_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("creator_profiles")
}

model Content {
  id        Int           @id @default(autoincrement())
  title     String
  body      String?
  status    ContentStatus @default(DRAFT)
  authorId  Int           @map("author_id")
  author    Member        @relation(fields: [authorId], references: [id])
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@map("contents")
}
