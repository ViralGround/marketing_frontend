generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CREATOR
  ADMIN
}

enum MemberStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EditingTool {
  CAPCUT
  PREMIERE
  FINAL_CUT
  VN
  OTHER
  NONE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum EditingSkill {
  HIGH
  MEDIUM
  LOW
}

enum CampaignStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  SUBMITTED
  SETTLED
}

model Member {
  id                   Int                   @id @default(autoincrement())
  email                String                @unique
  password             String
  name                 String
  role                 Role
  status               MemberStatus          @default(APPROVED)
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  contents             Content[]
  creatorProfile       CreatorProfile?
  campaignsCreated     Campaign[]            @relation("CampaignAuthor")
  applications         CampaignApplication[] @relation("CreatorApplications")

  @@map("members")
}

model CreatorProfile {
  id            Int          @id @default(autoincrement())
  memberId      Int          @unique @map("member_id")
  member        Member       @relation(fields: [memberId], references: [id])
  canEdit       Boolean      @default(false) @map("can_edit")
  editingSkill  EditingSkill @default(LOW) @map("editing_skill")
  editingTool   EditingTool? @map("editing_tool")
  gender        Gender?
  age           Int?
  faceExposure  Boolean      @default(false) @map("face_exposure")
  profileImage  String?      @map("profile_image")
  instagramId   String?      @map("instagram_id")
  tiktokId      String?      @map("tiktok_id")
  youtubeId     String?      @map("youtube_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("creator_profiles")
}

model Content {
  id        Int           @id @default(autoincrement())
  title     String
  body      String?
  status    ContentStatus @default(DRAFT)
  authorId  Int           @map("author_id")
  author    Member        @relation(fields: [authorId], references: [id])
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@map("contents")
}

model Campaign {
  id              Int                    @id @default(autoincrement())
  title           String
  description     String
  brandName       String                 @map("brand_name")
  rewardAmount    Int                    @map("reward_amount")
  thumbnailUrl    String?                @map("thumbnail_url")
  requirements    String?
  deadline        DateTime?
  maxParticipants Int                    @map("max_participants")
  status          CampaignStatus         @default(OPEN)
  createdById     Int                    @map("created_by_id")
  createdBy       Member                 @relation("CampaignAuthor", fields: [createdById], references: [id])
  applications    CampaignApplication[]
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  @@map("campaigns")
}

model CampaignApplication {
  id               Int               @id @default(autoincrement())
  campaignId       Int               @map("campaign_id")
  campaign         Campaign          @relation(fields: [campaignId], references: [id])
  creatorId        Int               @map("creator_id")
  creator          Member            @relation("CreatorApplications", fields: [creatorId], references: [id])
  status           ApplicationStatus @default(PENDING)
  message          String?
  submissionUrl    String?           @map("submission_url")
  rewardPaidAmount Int?              @map("reward_paid_amount")
  appliedAt        DateTime          @default(now()) @map("applied_at")
  reviewedAt       DateTime?         @map("reviewed_at")
  submittedAt      DateTime?         @map("submitted_at")
  settledAt        DateTime?         @map("settled_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@unique([campaignId, creatorId])
  @@map("campaign_applications")
}
